NEXT_PUBLIC_SITE_URL=https://canigetin.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
GOOGLE_PLACES_API_KEY=your_places_api_key
OPENAI_API_KEY=your-api-key
OPENAI_ACCESSIBILITY_MODEL=gpt-5-nano
OPENAI_PHOTO_MODERATION_MODEL=gpt-5-nano

# Server-only. Required for self-service account deletion.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Never expose a Supabase service role key through NEXT_PUBLIC_* variables.
